    <text:p text:style-name="_40_EquationWhere_20_">where:</text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">k</text:span><text:span text:style-name="ExpressionSub">ro</text:span><text:span text:style-name="ExpressionRegular">(</text:span><text:span text:style-name="Expression">S</text:span><text:span text:style-name="ExpressionSub">w</text:span><text:span text:style-name="ExpressionRegular">)</text:span><text:tab/>= relative permeability to oil,</text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">k</text:span><text:span text:style-name="ExpressionSub">rw</text:span><text:span text:style-name="ExpressionRegular">(</text:span><text:span text:style-name="Expression">S</text:span><text:span text:style-name="ExpressionSub">w</text:span><text:span text:style-name="ExpressionRegular">)</text:span><text:tab/>= relative permeability to water,</text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">n</text:span><text:span text:style-name="ExpressionSub">o</text:span><text:tab/>= Corey oil exponent, set to four in the original paper,</text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">n</text:span><text:span text:style-name="ExpressionSub">w</text:span><text:tab/>= Corey water exponent, set to four in the original paper,</text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">S</text:span><text:span text:style-name="ExpressionSub">w</text:span><text:tab/>= water saturation, and</text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">S</text:span><text:span text:style-name="ExpressionSub">wcr</text:span><text:tab/>= critical water saturation.</text:p>
    <text:p text:style-name="_40_EquationWhereList"/>
    <text:p text:style-name="P508">The denominator in equations <text:sequence-ref text:reference-format="caption" text:ref-name="refText0"/><text:sequence-ref text:reference-format="caption" text:ref-name="refText0"/><text:sequence-ref text:reference-format="text" text:ref-name="refText0">(2.1)</text:sequence-ref><text:s/>and <text:sequence-ref text:reference-format="text" text:ref-name="refText1">(2.2)</text:sequence-ref><text:s/>scales the water saturation to the mobile water phase. There are several forms of these equations, with the most common normalizing the saturation over the mobile hydrocarbon phase, <text:s/>as depicted in equations <text:sequence-ref text:reference-format="text" text:ref-name="refText2">(2.3)</text:sequence-ref><text:s/>and <text:sequence-ref text:reference-format="text" text:ref-name="refText3">(2.4)</text:sequence-ref>.</text:p>
