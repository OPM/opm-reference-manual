    <text:p text:style-name="_40_EquationWhere_20_">where:<text:tab/></text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">k</text:span><text:span text:style-name="ExpressionSub">ro,max</text:span><text:tab/>= maximum oil relative permeability at <text:span text:style-name="Expression">S</text:span><text:span text:style-name="ExpressionSub">wcr</text:span> ,</text:p>
    <text:p text:style-name="_40_EquationWhereList"><text:span text:style-name="Expression">k</text:span><text:span text:style-name="ExpressionSub">rw,max</text:span><text:tab/>= maximum water relative permeability at <text:span text:style-name="ExpressionRegular">1 - </text:span><text:span text:style-name="Expression">S</text:span><text:span text:style-name="ExpressionSub">orw</text:span> ,</text:p>
