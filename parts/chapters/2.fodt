          </office:binary-data>
         </draw:image>
        </draw:frame>Figure <text:sequence text:ref-name="refFigure3" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">2.4</text:sequence>: Ubuntu Guest Virtual Machine- Showing a Command Terminal</text:p>
      </draw:text-box>
     </draw:frame></text:p>
    <text:list xml:id="list140624369991812" text:continue-numbering="true" text:style-name="_40_BulletList">
     <text:list-item>
      <text:list>
       <text:list-item>
        <text:p text:style-name="P669"><text:soft-page-break/>One can then use the same commands as for a host machine, as described earlier in Sections <text:a xlink:type="simple" xlink:href="#2.1.1.Ubuntu Linux 24.04 (64-bit version only) and Higher|outline" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:bookmark-ref text:reference-format="number" text:ref-name="__RefHeading___Toc121657_2412586160">2.1.1</text:bookmark-ref><text:s/><text:bookmark-ref text:reference-format="text" text:ref-name="__RefHeading___Toc121657_2412586160">Ubuntu Linux 22.04 or 24.04 (64-bit version only)</text:bookmark-ref></text:a><text:s/>and <text:a xlink:type="simple" xlink:href="#2.1.2.Red Hat Enterprise or CentOS (version 7 or 8)|outline" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:bookmark-ref text:reference-format="number" text:ref-name="__RefHeading___Toc121659_2412586160">2.1.2</text:bookmark-ref><text:s/><text:bookmark-ref text:reference-format="text" text:ref-name="__RefHeading___Toc121659_2412586160">Red Hat Enterprise or CentOS (version 7 or 8)</text:bookmark-ref></text:a><text:s/>to install the software. <text:s text:c="2"/>To check if OPM Flow is installed, execute the following command in the terminal window:</text:p>
       </text:list-item>
      </text:list>
     </text:list-item>
    </text:list>
    <text:p text:style-name="P137">f<text:span text:style-name="T6">low –-help</text:span></text:p>
    <text:p text:style-name="P107"/>
    <text:p text:style-name="P571">which should then display the command line parameters for the installed version of OPM Flow, as depicted in <text:sequence-ref text:reference-format="category-and-value" text:ref-name="refFigure4">Figure 2.5.</text:sequence-ref></text:p>
    <text:list xml:id="list140623979593928" text:continue-list="list140623243759516" text:style-name="_40_NumberList">
