               aBN/Ey3rGgAAAABJRU5ErkJggg==
              </office:binary-data>
             </draw:image>
            </draw:frame>Figure <text:sequence text:ref-name="refFigure2" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">2.3</text:sequence>: Ubuntu Guest Virtual Machine Desktop in VirtualBox Example</text:p>
          </draw:text-box>
         </draw:frame>In order to install OPM Flow in the guest virtual machine one first needs to open a command terminal using ALT+CNTL+T key sequence (<text:sequence-ref text:reference-format="category-and-value" text:ref-name="refFigure3">Figure 2.4</text:sequence-ref>).</text:p>
       </text:list-item>
      </text:list>
     </text:list-item>
    </text:list>
